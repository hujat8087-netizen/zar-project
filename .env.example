# Web server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB (use a dedicated production user and TLS connection string in production)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pizza_point
MARKET_MONGODB_DB=zar_market

# Optional: creates the first admin only when the admins collection is empty.
# Use a unique password of at least 10 characters and remove it from the runtime
# environment after the first successful startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Existing restaurant/POS module credentials (only needed if that module is used)
MANAGER_PASSWORD=replace-with-a-long-random-password
PROTECTED_SECTION_PASSWORD=replace-with-a-different-long-password
