  padding: 15px 16px;
  border: 1px solid color-mix(in srgb, var(--system-primary) 18%, #e2e8f0);
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.045);
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.counter-custom-menu-item:hover {
  border-color: var(--system-primary);
  box-shadow: 0 12px 28px rgba(15, 118, 110, 0.1);
  transform: translateY(-1px);
}

.counter-menu-item-name strong {
  display: block;
  color: #0f172a;
  font-size: 1.02rem;
  line-height: 1.5;
}

.counter-custom-menu-item span {
  display: block;
  margin-top: 4px;
  color: #64748b;
  font-size: 0.86rem;
}

.counter-menu-price-editor {
  padding: 5px;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: #f8fafc;
}

.counter-menu-price-editor > span {
  margin: 0;
  padding-inline: 2px;
  color: #64748b;
  font-size: 0.78rem;
  font-weight: 900;
}

.counter-menu-price-editor .input {
  min-height: 42px;
  border-color: #cbd5e1;
  border-radius: 10px;
  background: #fff;
  font-size: 1rem;
  font-weight: 800;
}

.counter-menu-price-editor .button {
  min-height: 42px;
  border-radius: 10px;
  box-shadow: none;
}

.counter-menu-price-editor .button.success {
  border-color: #0f766e;
  background: #0f766e;
}

.counter-menu-price-editor .button.danger {
  border-color: #fee2e2;
  background: #fff1f2;
  color: #be123c;
}

.counter-menu-price-editor .button.danger:hover {
  border-color: #e11d48;
  background: #e11d48;
  color: #fff;
}

.counter-custom-menu-item [data-delete-menu-item] {
  display: inline-flex;
}

.counter-order-times {
  display: grid;
  gap: 3px;
  margin-top: 7px;
}

.counter-order-time {
  color: var(--text, #172033);
}

.counter-order-datetime {
  display: inline-block;
  direction: ltr;
  unicode-bidi: isolate;
  white-space: nowrap;
}

@media (max-width: 900px) {
  .counter-menu-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .counter-menu-manager {
    padding-inline: 16px;
  }

  .counter-menu-manager > .panel-header {
    margin-inline: -16px;
  }

  .counter-custom-menu-item {
    align-items: stretch;
    flex-direction: column;
  }

  .counter-menu-price-editor {
    display: grid;
    grid-template-columns: minmax(100px, 1fr) auto auto auto;
  }

  .counter-theme-mixer {
    align-items: stretch;
    flex-direction: column;
  }

  .counter-theme-controls {
    flex-wrap: wrap;
  }

  .counter-expense-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .counter-menu-form,
  .counter-custom-menu-list {
    grid-template-columns: 1fr;
  }

  .counter-custom-menu-item,
  .counter-menu-price-editor {
    align-items: stretch;
    flex-direction: column;
  }

  .counter-menu-price-editor .input {
    width: 100%;
  }

  .counter-menu-manager {
    padding: 0 10px 16px;
    border-radius: 18px;
  }

  .counter-menu-manager > .panel-header {
    margin: 0 -10px 16px;
    padding: 18px 16px;
  }

  .counter-menu-form {
    padding: 14px;
    border-radius: 14px;
  }

  .counter-menu-price-editor {
    display: flex;
  }

  .counter-theme-controls .button {
    width: 100%;
  }

  .counter-expense-head,
  .counter-expense-item {
    align-items: stretch;
    grid-template-columns: 1fr;
  }

  .counter-expense-head {
    flex-direction: column;
  }

  .counter-expense-total {
    width: 100%;
  }

  .counter-expense-form {
    grid-template-columns: 1fr;
  }

  .counter-menu-search {
    top: 70px;
    padding: 10px;
  }

  .counter-menu-search-bar {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .counter-menu-search-bar .button {
    grid-column: 1 / -1;
  }
}

.menu-manager-form .select,
.menu-manager-form .button {
  width: 100%;
}

.field-hint {
  display: block;
  margin-top: 7px;
  color: var(--muted, #687080);
}

.menu-manager-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

@media (max-width: 600px) {
  .menu-manager-item {
    align-items: stretch;
    flex-direction: column;
  }
}
.hujat-intro {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: grid;
  place-items: center;
  overflow: hidden;
  padding: 24px;
  color: #fff;
  text-align: center;
  background:
    radial-gradient(circle at 50% 36%, rgba(255, 190, 60, 0.18), transparent 30%),
    linear-gradient(145deg, #05070c 0%, #101827 52%, #020305 100%);
  animation: hujatIntroIn 0.45s ease both;
}

.hujat-intro.is-leaving {
  pointer-events: none;
  animation: hujatIntroOut 0.6s ease forwards;
}

.hujat-intro-glow {
  position: absolute;
  width: min(78vw, 620px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 178, 44, 0.2), transparent 67%);
  animation: hujatGlow 2s ease-in-out infinite alternate;
}

.hujat-intro-content {
  position: relative;
  z-index: 1;
  display: grid;
  justify-items: center;
}

.hujat-intro-photo-wrap {
  position: relative;
  width: clamp(150px, 32vw, 230px);
  aspect-ratio: 1;
  margin-bottom: 24px;
  animation: hujatPortraitIn 0.9s cubic-bezier(.2,.8,.2,1) both;
}

.hujat-intro-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 24%;
  border: 4px solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-shadow: 0 0 0 8px rgba(255, 179, 45, 0.15), 0 22px 70px rgba(0, 0, 0, 0.62);
  animation: hujatPhotoLife 3.3s 0.7s ease-in-out both;
}

.hujat-intro-orbit {
  position: absolute;
  inset: -13px;
  border: 2px solid transparent;
  border-top-color: #ffb52e;
  border-right-color: rgba(255, 255, 255, 0.65);
  border-radius: 50%;
  animation: hujatOrbit 2.6s linear infinite;
}

.hujat-intro-welcome,
.hujat-intro-role {
  margin: 0;
  color: #f7c66b;
  font-weight: 700;
  letter-spacing: 0.08em;
  animation: hujatTextIn 0.6s 0.35s ease both;
}

.hujat-intro-title {
  margin: 8px 0 0;
  font-size: clamp(2rem, 7vw, 4.4rem);
  line-height: 1;
  letter-spacing: 0.02em;
  text-shadow: 0 8px 34px rgba(255, 178, 44, 0.28);
  animation: hujatTextIn 0.65s 0.5s ease both;
}

.hujat-intro-local {
  margin: 10px 0 12px;
  color: #fff0cf;
  font-size: clamp(1.55rem, 5vw, 2.7rem);
  animation: hujatTextIn 0.65s 0.65s ease both;
}

.hujat-intro-role {
  color: rgba(255, 255, 255, 0.76);
  font-size: 0.86rem;
  letter-spacing: 0.03em;
  animation-delay: 0.78s;
}

.hujat-intro-loader {
  width: min(260px, 65vw);
  height: 3px;
  margin-top: 22px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
}

.hujat-intro-loader span {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff9f1c, #ffe3a4);
  transform-origin: left;
  animation: hujatLoad 3.3s 0.25s ease-out both;
}

@keyframes hujatIntroIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes hujatIntroOut { to { opacity: 0; transform: scale(1.04); } }
@keyframes hujatPortraitIn { from { opacity: 0; transform: translateY(28px) scale(0.7); } to { opacity: 1; transform: none; } }
@keyframes hujatPhotoLife { 0%, 100% { transform: scale(1); } 55% { transform: scale(1.045); filter: brightness(1.08); } }
@keyframes hujatTextIn { from { opacity: 0; transform: translateY(18px); filter: blur(7px); } to { opacity: 1; transform: none; filter: none; } }
@keyframes hujatOrbit { to { transform: rotate(360deg); } }
@keyframes hujatGlow { to { transform: scale(1.13); opacity: 0.65; } }
@keyframes hujatLoad { from { transform: scaleX(0); } to { transform: scaleX(1); } }

@media (prefers-reduced-motion: reduce) {
  .hujat-intro, .hujat-intro *, .hujat-intro::before, .hujat-intro::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
