/* Simple thermal receipt — Counter (XP-365B) */
.receipt-simple {
  box-sizing: border-box;
  width: 76mm;
  max-width: 76mm;
  margin: 0 auto;
  padding: 2mm 1mm 2.5mm;
  background: #fff;
  color: #000;
  font-family: Tahoma, Arial, sans-serif;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.45;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

.receipt-simple,
.receipt-simple * {
  font-weight: 700 !important;
  color: #000 !important;
}

.receipt-simple-logo {
  display: block;
  width: 26mm;
  height: 26mm;
  object-fit: contain;
  margin: 0 auto 2mm;
  /* The source logo has a black background. Invert it for thermal paper so
     the artwork prints black on white instead of as a solid dark block. */
  filter: grayscale(1) invert(1) contrast(1.35) brightness(1.08);
}
.receipt-simple-brand { margin: 0 auto 2mm; padding: 2mm 1mm; border: 2px solid #000; font-size: 24px; font-weight: 1000; line-height: 1.2; text-align: center; }

.receipt-simple-title {
  margin: 0 0 4mm;
  text-align: center;
  font-size: 22px;
  line-height: 1.2;
}

.receipt-print-mark {
  margin: 0 0 1mm;
  padding: 1.5mm 1mm;
  border: 2px solid #000;
  text-align: center;
  font-size: 20px;
  line-height: 1.15;
}

.receipt-print-time {
  margin: 0 0 3mm;
  text-align: center;
  font-size: 16px;
  line-height: 1.25;
}

.receipt-simple-info {
  display: grid;
  gap: 2mm;
}

.receipt-simple-info-row {
  display: grid;
  grid-template-columns: 30mm 1fr;
  gap: 2mm;
  align-items: start;
  font-size: 16px;
  line-height: 1.3;
}

.receipt-simple-info-row strong {
  word-break: break-word;
}

.receipt-simple-line {
  margin: 0 0 3mm;
  text-align: left;
  font-size: 13px;
}

.receipt-simple-ul {
  text-decoration: underline;
}

.receipt-simple-hr {
  border: 0;
  border-top: 1px dashed #000;
  margin: 5mm 0;
}

.receipt-simple-hr-double {
  border: 0;
  border-top: 3px double #000;
  margin: 5mm 0;
}

.receipt-simple-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  border: 1.5px solid #000;
}

.receipt-simple-table th,
.receipt-simple-table td {
  border: 1px solid #000;
  padding: 2mm 0;
  vertical-align: top;
  text-align: center;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.25;
}

.receipt-simple-table th {
  padding: 1.5mm 0.5mm;
  direction: rtl;
  font-size: 11px;
}

.receipt-simple-table th:nth-child(1),
.receipt-simple-table td:nth-child(1) {
  width: 9%;
}

.receipt-simple-table th:nth-child(2),
.receipt-simple-table td:nth-child(2) {
  width: 43%;
}

.receipt-simple-table th:nth-child(3),
