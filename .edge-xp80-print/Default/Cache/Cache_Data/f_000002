:root {
  --system-primary: #0f766e;
  --system-accent: #2563eb;
  --bg: #f6f5f2;
  --surface: #ffffff;
  --surface-soft: #faf7f0;
  --ink: #171717;
  --muted: #64748b;
  --line: #dedbd3;
  --brand: #18202f;
  --brand-2: #8a4b12;
  --amber: #b45309;
  --amber-soft: #fff7ed;
  --green: #0f766e;
  --green-soft: #ecfdf5;
  --red: #b91c1c;
  --red-soft: #fff1f2;
  --blue: #1d4ed8;
  --blue-soft: #eff6ff;
  --shadow: 0 12px 30px rgba(24, 32, 47, 0.08);
}

/* Manager-controlled colors shared by the whole system. */
.app-header {
  border-bottom-color: var(--system-primary);
}

.app-header .nav-link.active,
.button.primary {
  background: linear-gradient(135deg, var(--system-primary), var(--system-accent));
}

.button.success {
  background: var(--system-primary);
}

.status-chip.success,
.chip.success {
  color: var(--system-primary);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  min-height: 100%;
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: "Segoe UI", Tahoma, Arial, sans-serif;
  line-height: 1.5;
  overflow-x: clip;
  -webkit-tap-highlight-color: transparent;
}

@supports (padding: env(safe-area-inset-top)) {
  .app-header {
    padding-top: env(safe-area-inset-top);
  }

  .page {
    padding-bottom: calc(36px + env(safe-area-inset-bottom));
  }

  .login-screen {
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
    padding-left: calc(24px + env(safe-area-inset-left));
    padding-right: calc(24px + env(safe-area-inset-right));
  }
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

.hidden {
  display: none !important;
}

.app-shell {
  min-height: 100vh;
}

.app-header {
  position: sticky;
  top: 0;
  z-index: 30;
  background:
    linear-gradient(135deg, #141b27 0%, #1f2a3d 52%, #243247 100%);
  color: #fff;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
}

.app-header::after {
  content: "";
  display: block;
  height: 3px;
  background: linear-gradient(90deg, #8a4b12, #f4c26a, #8a4b12);
}

.header-inner {
  width: min(1280px, calc(100% - 32px));
  min-height: 72px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 0;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  color: inherit;
  text-decoration: none;
}

.brand-mark {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.55), transparent 20%),
    linear-gradient(145deg, #f59e0b 0%, #d97706 42%, #7c2d12 100%);
  color: #fff;
  border: 1px solid rgba(255, 237, 213, 0.42);
  font-size: 0.78rem;
  font-weight: 950;
  letter-spacing: 0.02em;
  box-shadow:
    0 10px 22px rgba(180, 83, 9, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.28);
}

.brand-text {
  min-width: 0;
}

.eyebrow {
  margin: 0 0 2px;
  color: #f4c26a;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.brand-title {
  margin: 0;
  font-size: clamp(1.05rem, 2vw, 1.45rem);
  font-weight: 950;
  line-height: 1.15;
  letter-spacing: 0.01em;
  background: linear-gradient(90deg, #ffffff 0%, #fde68a 48%, #fb923c 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 10px 24px rgba(251, 146, 60, 0.2);
}

.brand-subtitle {
  margin: 2px 0 0;
  color: rgba(255, 255, 255, 0.68);
  font-size: 0.86rem;
  line-height: 1.35;
}

.nav-toggle {
  display: none;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
  cursor: pointer;
}

.nav-toggle span {
  display: block;
  width: 18px;
  height: 2px;
  margin: 4px auto;
  border-radius: 999px;
  background: currentColor;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.nav-toggle[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(6px) rotate(45deg);
}

.nav-toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.nav-toggle[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-6px) rotate(-45deg);
}

.header-end {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.header-nav {
  display: flex;
  align-items: center;
}

.nav-pills {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(8px);
}

.top-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
}

.header-tools {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.nav-link,
.button,
.icon-button {
  min-height: 40px;
  border: 1px solid transparent;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 800;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

.app-header .nav-link {
  min-height: 38px;
  padding: 8px 14px;
  border-radius: 999px;
  background: transparent;
  color: rgba(255, 255, 255, 0.78);
  border-color: transparent;
  font-size: 0.9rem;
  white-space: nowrap;
}

.app-header .nav-link:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
}

.app-header .nav-link.active {
  color: #fff;
  background: linear-gradient(145deg, #d97706, #b45309);
  box-shadow: 0 8px 18px rgba(180, 83, 9, 0.28);
}

.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 32px;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.92);
  font-size: 0.76rem;
  font-weight: 900;
  white-space: nowrap;
}

.status-chip.warning {
  border-color: rgba(251, 191, 36, 0.35);
  background: rgba(180, 83, 9, 0.22);
  color: #fde68a;
}

.status-chip.ready {
  border-color: rgba(52, 211, 153, 0.35);
  background: rgba(15, 118, 110, 0.28);
  color: #a7f3d0;
}

.tool-button {
  min-height: 38px;
  padding: 8px 14px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.9);
  font-weight: 800;
  cursor: pointer;
}

.tool-button:hover {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
}

.button {
  padding: 10px 14px;
  background: #f3f4f6;
  color: var(--ink);
}

.button:hover,
.icon-button:hover {
  transform: translateY(-1px);
}

.button.primary {
  background: var(--amber);
  color: #fff;
}

.button.success {
  background: var(--green);
  color: #fff;
}

.button.danger {
  background: var(--red);
  color: #fff;
}

.button.dark {
  background: var(--brand);
  color: #fff;
}

.button.ghost {
  background: transparent;
  border-color: var(--line);
}

.icon-button {
  width: 40px;
  height: 40px;
  padding: 0;
  background: #f3f4f6;
  color: var(--ink);
}

.page {
  width: min(1280px, calc(100% - 32px));
  margin: 0 auto;
  padding: 22px 0 36px;
}

.page-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
  gap: 18px;
  align-items: start;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 16px;
}

.side-stack {
  display: grid;
  gap: 16px;
  align-content: start;
}

.span-4 {
  grid-column: span 4;
}

.span-5 {
  grid-column: span 5;
}

.span-7 {
  grid-column: span 7;
}

.span-8 {
  grid-column: span 8;
}

.span-12 {
  grid-column: span 12;
}

.panel,
.role-card,
.order-card,
.bill-card,
.menu-row {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 8px;
  box-shadow: var(--shadow);
}

.panel {
  padding: 18px;
  min-width: 0;
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.panel-title {
  margin: 0;
  font-size: 1.08rem;
  font-weight: 900;
}

.panel-kicker {
  margin: 2px 0 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.field {
  display: grid;
  gap: 6px;
}

.field label {
  color: #334155;
  font-size: 0.86rem;
  font-weight: 800;
}

.password-field {
  position: relative;
}

.password-field .input {
  padding-right: 52px;
}

.password-toggle {
  position: absolute;
  right: 4px;
  top: 50%;
  transform: translateY(-50%);
  min-width: 44px;
  min-height: 36px;
  padding: 4px 8px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--muted);
  font-size: 0.78rem;
  font-weight: 800;
  cursor: pointer;
}

.password-toggle:hover {
  background: #f1f5f9;
  color: var(--ink);
}

.password-toggle:focus-visible {
  outline: 2px solid var(--amber);
  outline-offset: 1px;
}

.input,
.select,
.textarea {
  width: 100%;
  min-height: 44px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #fff;
  color: var(--ink);
  padding: 10px 12px;
  outline: none;
}

.textarea {
  min-height: 86px;
  resize: vertical;
}

.input:focus,
.select:focus,
.textarea:focus {
  border-color: var(--amber);
  box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.16);
}

.login-screen {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background:
    linear-gradient(rgba(24, 32, 47, 0.86), rgba(24, 32, 47, 0.88)),
    url("/images/kabuli.jpg") center / cover;
}

.login-panel {
  width: min(440px, 100%);
  padding: 24px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 8px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.22);
}

.login-panel .eyebrow {
  color: var(--brand-2);
}

.login-panel h1 {
  margin: 0 0 6px;
  font-size: clamp(1.45rem, 5vw, 1.8rem);
}

.login-panel p {
  margin: 0 0 18px;
  color: var(--muted);
}

.login-panel .button {
  width: 100%;
}

.notice {
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px 14px;
  background: var(--surface-soft);
  color: #334155;
  font-weight: 700;
}

.notice.success {
  border-color: #99f6e4;
  background: var(--green-soft);
  color: #115e59;
}

.notice.danger {
  border-color: #fecdd3;
  background: var(--red-soft);
  color: #9f1239;
}

.ready-banner {
  position: sticky;
  top: 86px;
  z-index: 18;
  width: min(1280px, calc(100% - 32px));
  margin: 14px auto 0;
  border: 1px solid #99f6e4;
  border-radius: 8px;
  background: var(--green);
  color: #fff;
  padding: 14px 16px;
  font-weight: 900;
  box-shadow: var(--shadow);
}

.update-banner {
  border-color: #fed7aa;
  background: var(--amber);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

.stat {
  min-height: 92px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
}

.stat-label {
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 800;
}

.stat-value {
  margin-top: 6px;
  font-size: clamp(1.2rem, 4vw, 1.7rem);
  font-weight: 950;
  overflow-wrap: anywhere;
  line-height: 1.15;
}

.table-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
}

.table-button {
  min-height: 68px;
  padding: 8px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  color: var(--ink);
  text-align: left;
}

.table-button strong,
.table-button span {
  display: block;
}

.table-button strong {
  font-size: 1rem;
}

.table-button span {
  color: var(--muted);
  font-size: 0.76rem;
  font-weight: 800;
}

.table-button.selected {
  border-color: var(--amber);
  background: var(--amber-soft);
}

.table-button.open {
  border-color: #93c5fd;
  background: var(--blue-soft);
}

.table-button.ready {
  border-color: #99f6e4;
  background: var(--green-soft);
}

.menu-section {
  position: relative;
  margin-top: 6px;
  padding: 16px;
  border: 1px solid #ebe4d8;
  border-radius: 18px;
  background:
    radial-gradient(circle at top right, rgba(244, 194, 106, 0.14), transparent 42%),
    linear-gradient(180deg, #fffdf8 0%, #ffffff 100%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.menu-section-head {
  display: grid;
  gap: 2px;
}

.menu-panel-header {
  margin-bottom: 0;
}

.menu-clear-btn {
  border-color: #e7dfd3 !important;
  background: rgba(255, 255, 255, 0.72) !important;
}

.menu-filters {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6px;
  margin: 14px 0 16px;
  padding: 5px;
  border: 1px solid #e8e1d6;
  border-radius: 14px;
  background: #f3efe8;
}

.menu-filter {
  min-height: 44px;
  padding: 8px 6px;
  border: none;
  border-radius: 10px;
  background: transparent;
  color: #64748b;
  font-size: 0.74rem;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.menu-filter:hover {
  color: #9a3412;
  background: rgba(255, 255, 255, 0.55);
}

.menu-filter.active {
  color: #9a3412;
  background: #fff;
  box-shadow:
    0 8px 20px rgba(180, 83, 9, 0.12),
    0 1px 2px rgba(24, 32, 47, 0.06);
  transform: translateY(-1px);
}

.menu-list {
  display: grid;
  gap: 12px;
}

.menu-back-top {
  position: fixed;
  left: max(18px, env(safe-area-inset-left));
  bottom: max(22px, env(safe-area-inset-bottom));
  z-index: 60;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 46px;
  padding: 10px 16px;
  border: 1px solid #f0d9b8;
  border-radius: 999px;
  background: linear-gradient(145deg, #fff7ed 0%, #ffffff 100%);
  color: #9a3412;
  font-size: 0.86rem;
  font-weight: 900;
  line-height: 1;
  cursor: pointer;
  touch-action: manipulation;
  box-shadow:
    0 14px 30px rgba(180, 83, 9, 0.18),
    0 2px 6px rgba(24, 32, 47, 0.08);
  transition:
    opacity 0.22s ease,
    transform 0.22s ease,
    visibility 0.22s ease;
}

.menu-back-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.menu-back-top:not(.is-visible) {
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px);
  pointer-events: none;
}

.menu-back-top:hover {
  transform: translateY(-2px);
  border-color: #fdba74;
  box-shadow:
    0 18px 34px rgba(180, 83, 9, 0.22),
    0 4px 10px rgba(24, 32, 47, 0.1);
}

.menu-back-top-icon {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, #ea580c, #c2410c);
  color: #fff;
  font-size: 1rem;
  font-weight: 900;
  line-height: 1;
}

@media (min-width: 981px) {
  .menu-back-top {
    bottom: max(28px, env(safe-area-inset-bottom));
  }
}

.menu-group {
  border: 1px solid #e8e1d6;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 4px 16px rgba(24, 32, 47, 0.05);
  overflow: hidden;
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
}

.menu-group:hover {
  box-shadow: 0 10px 28px rgba(24, 32, 47, 0.08);
}

.menu-group.is-selected {
  border-color: #f59e0b;
  box-shadow: 0 14px 32px rgba(180, 83, 9, 0.14);
}

.menu-group.is-open {
  border-color: #f0c987;
  transform: translateY(-1px);
}

.menu-group > .menu-variants {
  display: none;
}

.menu-group.is-open > .menu-variants {
  display: grid;
  max-height: min(68vh, 560px);
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}

.menu-group-rich.is-open .menu-variants {
  animation: menuReveal 0.28s ease;
}

@keyframes menuReveal {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.menu-group-toggle {
  width: 100%;
  display: grid;
  grid-template-columns: 84px minmax(0, 1fr) auto auto;
  gap: 14px;
  align-items: center;
  padding: 14px;
  border: 0;
  background: linear-gradient(135deg, #ffffff 0%, #fffaf3 100%);
  text-align: left;
  cursor: pointer;
  touch-action: manipulation;
}

.menu-group-toggle:hover {
  background: linear-gradient(135deg, #fffdf8 0%, #fff4e4 100%);
}

.menu-group.is-open .menu-group-toggle {
  background: linear-gradient(135deg, #fff8ee 0%, #fff2de 100%);
  border-bottom: 1px solid #f1e3cf;
}

.menu-hint {
  margin: 6px 0 0;
  color: #94a3b8;
  font-size: 0.76rem;
  font-weight: 800;
}

.menu-badge {
  min-width: 30px;
  min-height: 30px;
  padding: 0 9px;
  border-radius: 999px;
  display: inline-grid;
  place-items: center;
  background: linear-gradient(145deg, #ea580c, #c2410c);
  color: #fff;
  font-size: 0.78rem;
  font-weight: 900;
  box-shadow: 0 6px 14px rgba(234, 88, 12, 0.28);
}

.menu-chevron {
  width: 34px;
  height: 34px;
  border-radius: 12px;
  border: 1px solid #eadfce;
  background: #fff;
  position: relative;
  flex-shrink: 0;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.menu-chevron::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8px;
  height: 8px;
  border-right: 2px solid #9a3412;
  border-bottom: 2px solid #9a3412;
  transform: translate(-50%, -60%) rotate(45deg);
  transition: transform 0.22s ease;
}

.menu-group.is-open .menu-chevron {
  background: #fff7ed;
  border-color: #fdba74;
}

.menu-group.is-open .menu-chevron::before {
  transform: translate(-50%, -35%) rotate(-135deg);
}

.menu-variants {
  display: grid;
  gap: 12px;
  padding: 14px;
  background:
    radial-gradient(circle at top left, rgba(251, 191, 36, 0.08), transparent 34%),
    linear-gradient(180deg, #fffaf3 0%, #ffffff 100%);
}

.menu-variant-section--biryani {
