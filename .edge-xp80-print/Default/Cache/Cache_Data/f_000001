<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#18202f" />
  <title>Counter | زعفران بریانی</title>
  <link rel="manifest" href="/manifest.json" />
  <link rel="stylesheet" href="/styles.css?v=80" />
  <script src="/password-toggle.js"></script>
  <script src="/auth.js"></script>
  <script src="/theme.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/menu-custom.js?v=48"></script>
  <script src="/menu-data.js?v=51"></script>
</head>
<body>
  <section id="loginScreen" class="login-screen">
    <div class="login-panel">
      <p class="eyebrow">زعفران بریانی</p>
      <h1>Counter Login</h1>
      <p>Cashier and sales history</p>
      <div class="field">
        <label for="counterPassword">Password</label>
        <div class="password-field">
          <input id="counterPassword" class="input" type="password" autocomplete="current-password" placeholder="Enter password" />
          <button type="button" class="password-toggle" data-password-toggle aria-controls="counterPassword" aria-label="Show password" aria-pressed="false">Show</button>
        </div>
      </div>
      <div style="height: 12px"></div>
      <button id="loginButton" class="button primary" type="button">Login</button>
      <div id="loginMessage" class="notice danger hidden" style="margin-top: 12px"></div>
    </div>
  </section>

  <div id="app" class="app-shell hidden">
    <header class="app-header">
      <div class="header-inner">
        <a class="brand-block" href="/">
          <span class="brand-mark" aria-hidden="true">زب</span>
          <div class="brand-text">
            <p class="eyebrow">Counter Desk</p>
            <h1 class="brand-title">زعفران بریانی</h1>
            <p class="brand-subtitle">Checkout, open tables, and daily revenue</p>
          </div>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="appNav" aria-label="د حساب انتخابونه">
          <span></span><span></span><span></span>
        </button>

        <div class="header-end" id="appNav">
          <div class="header-tools">
            <span id="offlineBadge" class="status-chip warning">Checking</span>
            <button id="logoutButton" class="tool-button" type="button">Logout</button>
          </div>
        </div>
      </div>
    </header>

    <main class="page counter-dashboard-page">
      <section class="stat-grid counter-stat-grid" aria-label="Counter stats">
        <div class="stat counter-stat counter-stat--tables">
          <div class="stat-label">Active tables</div>
          <div id="statTables" class="stat-value">0</div>
        </div>
        <div class="stat counter-stat counter-stat--balance">
          <div class="stat-label">Open balance</div>
          <div id="statOpenTotal" class="stat-value">0 AFN</div>
        </div>
        <div class="stat counter-stat counter-stat--paid">
          <div class="stat-label">Daily Revenue · ورځنی عاید</div>
          <div id="statRevenue" class="stat-value">0 AFN</div>
          <div id="statRevenueDetails" class="counter-stat-detail">عاید 0 · مصرف 0</div>
        </div>
        <div class="stat counter-stat counter-stat--status">
          <div class="stat-label">Counter status</div>
          <div id="connectionStatus" class="stat-value" style="font-size: 1.2rem">Connecting</div>
        </div>
      </section>

      <div class="counter-menu-launcher">
        <button id="toggleMenuManagerButton" class="button ghost" type="button" aria-expanded="false" aria-controls="counterMenuManager">
          د مینیو مدیریت ښکاره کړه
        </button>
      </div>

      <section id="counterMenuManager" class="panel counter-menu-manager hidden" aria-labelledby="counterMenuTitle">
        <div class="panel-header">
          <div>
            <h2 id="counterMenuTitle" class="panel-title">د ټولې مینیو او نرخونو مدیریت</h2>
            <p class="panel-kicker">ټولې کټګورۍ او خواړه دلته دي؛ هر نرخ بدل او سمدستي یې دایمي خوندي کړئ</p>
          </div>
          <div class="top-actions">
            <span id="customMenuCount" class="chip">0 خواړه</span>
            <button id="hideMenuManagerButton" class="button ghost" type="button">برخه پټه کړه</button>
          </div>
        </div>

        <nav class="manager-command-nav" aria-label="د مدیریت برخې">
          <button class="manager-command active" type="button" data-manager-view="menu"><span>☰</span><b>مینیو</b><small>خواړه او نرخونه</small></button>
          <button class="manager-command" type="button" data-manager-view="account"><span>▦</span><b>میاشتنی حساب</b><small>هره ورځ جلا</small></button>
          <button class="manager-command" type="button" data-manager-view="annual"><span>⌁</span><b>کلني حسابونه</b><small>هر کال جلا</small></button>
          <button class="manager-command" type="button" data-manager-view="staff"><span>♟</span><b>کارمندان</b><small>معاش او کرایه</small></button>
          <button class="manager-command" type="button" data-manager-view="expenses"><span>−</span><b>مصارف</b><small>ورځنی لګښت</small></button>
          <button class="manager-command" type="button" data-manager-view="inventory"><span>▤</span><b>سټاک</b><small>داخل او پاتې</small></button>
          <button class="manager-command" type="button" data-manager-view="capital"><span>◇</span><b>پانګه</b><small>دایمي شتمني</small></button>
        </nav>
        <div id="menuManagerMessage" class="notice hidden manager-global-notice"></div>

        <div id="managerViewHeading" class="manager-view-heading">
          <div><span id="managerViewEyebrow">MENU CONTROL</span><h3 id="managerViewTitle">د مینیو او نرخونو مدیریت</h3><p id="managerViewDescription">خواړه اضافه، نرخونه بدل او مینیو په اسانه ډول اداره کړئ.</p></div>
        </div>

        <div id="financeWorkspace" class="finance-workspace" dir="rtl">

        <section class="monthly-account manager-view-panel hidden" data-manager-panel="account" aria-labelledby="monthlyAccountTitle">
          <div class="monthly-account-head">
            <div>
              <span class="counter-expense-eyebrow">Monthly Account</span>
              <h3 id="monthlyAccountTitle" class="finance-title"><span class="finance-icon blue" aria-hidden="true">▦</span> میاشتنی حساب</h3>
              <p id="monthlyAccountPeriod">د Checkout خرڅلاو او مصارف دلته دایمي خوندي کېږي.</p>
            </div>
            <div class="finance-head-actions">
              <label class="field">میاشت <input id="financeMonth" class="input" type="month" /></label>
              <button id="refreshFinanceButton" class="button ghost" type="button">حساب تازه کړه</button>
              <button id="deleteMonthlyAccountButton" class="button danger" type="button">میاشتنی حساب حذف کړه</button>
            </div>
          </div>
          <div class="monthly-account-stats">
            <div><span>ټول خرڅلاو</span><strong id="monthlySalesTotal">0 AFN</strong></div>
            <div><span>ټول مصرف</span><strong id="monthlyExpenseTotal">0 AFN</strong></div>
            <div><span>د خرڅ شویو اجناسو پېر</span><strong id="monthlyInventoryCost">0 AFN</strong></div>
            <div><span>حقیقي خالصه ګټه</span><strong id="monthlyNetTotal">0 AFN</strong></div>
            <div><span>خرڅ شوي توکي</span><strong id="monthlyUnitsTotal">0</strong></div>
          </div>
          <div>
            <h4 class="monthly-items-title">د میاشتې ورځنی حساب</h4>
            <div id="monthlyDayList" class="monthly-day-list"></div>
          </div>
          <div>
            <h4 class="monthly-items-title">د هر جنس د خرڅلاو شمېر</h4>
            <div id="monthlyItemList" class="monthly-item-list"></div>
          </div>
          <div>
            <h4 class="monthly-items-title">د میاشتې مصارف</h4>
            <div id="monthlyExpenseList" class="monthly-item-list"></div>
          </div>
        </section>

        <section class="finance-center manager-view-panel hidden" data-manager-panel="annual" aria-labelledby="financeCenterTitle">
          <div class="counter-expense-head">
            <div><span class="counter-expense-eyebrow">Annual Finance</span><h3 id="financeCenterTitle" class="finance-title"><span class="finance-icon violet" aria-hidden="true">⌁</span> کلنی حساب او د مدیر خالصه ګټه</h3><p>خرڅلاو منفي ټول مصارف، معاشونه او کرایه.</p></div>
            <div class="finance-year-actions">
              <label class="field">کال <select id="financeYear" class="input"></select></label>
              <button id="deleteAnnualAccountButton" class="button danger" type="button">د ټاکلي کال حساب حذف کړه</button>
            </div>
          </div>
          <div class="monthly-account-stats">
            <div><span>کلنی خرڅلاو</span><strong id="annualSalesTotal">0 AFN</strong></div>
            <div><span>کلني مصارف</span><strong id="annualExpenseTotal">0 AFN</strong></div>
            <div><span>د خرڅ شویو اجناسو پېر</span><strong id="annualInventoryCost">0 AFN</strong></div>
            <div><span>د مدیر حقیقي ګټه</span><strong id="annualProfitTotal">0 AFN</strong></div>
            <div><span>ثبت شوي کارمندان</span><strong id="employeeCount">0</strong></div>
          </div>
          <div id="annualMonthList" class="annual-month-list"></div>
          <details class="annual-expense-ledger" open>
            <summary>د ټاکلي کال د ټولو مصارفو تفصیل</summary>
            <div id="annualExpenseCategorySummary" class="expense-category-summary"></div>
            <div id="annualExpenseDetailList" class="annual-expense-detail-list"></div>
          </details>
        </section>

        <section class="finance-grid manager-view-panel hidden" data-manager-panel="staff">
          <div class="staff-financial-sync" aria-live="polite">
            <div><span>د همدې میاشتې معاشونه</span><strong id="staffSalaryExpenseTotal">0 AFN</strong></div>
            <div><span>د همدې میاشتې کرایه</span><strong id="staffRentExpenseTotal">0 AFN</strong></div>
            <div><span>له ګټې ټول منفي شوي</span><strong id="staffCombinedExpenseTotal">0 AFN</strong></div>
            <p id="staffSyncStatus">له MongoDB مالي حساب سره اتومات وصل</p>
          </div>
          <div class="finance-card">
            <h3 class="finance-title"><span class="finance-icon cyan" aria-hidden="true">♟</span> کارمندان</h3>
            <form id="employeeForm" class="finance-form">
              <input id="employeeName" class="input" maxlength="100" placeholder="د کارمند نوم" required />
              <input id="employeeRole" class="input" maxlength="100" placeholder="دنده، مثال: آشپز" required />
              <input id="employeePhone" class="input" maxlength="30" placeholder="د ټیلیفون شمېره" />
              <input id="employeeSalary" class="input" type="number" min="1" placeholder="میاشتنی معاش" required />
              <button class="button success" type="submit">کارمند ثبت کړه</button>
            </form>
            <div id="employeeList" class="finance-list"></div>
          </div>
          <div class="finance-card">
            <h3 class="finance-title"><span class="finance-icon green" aria-hidden="true">✓</span> د معاش رسید</h3>
            <form id="payrollForm" class="finance-form">
              <select id="payrollEmployee" class="select" required></select>
              <input id="payrollPeriod" class="input" type="month" required />
              <input id="payrollAmount" class="input" type="number" min="1" placeholder="ورکړل شوی معاش" required />
              <input id="payrollNote" class="input" maxlength="200" placeholder="د معاش وجه" required />
              <button class="button success" type="submit">معاش رسید کړه</button>
            </form>
            <div id="payrollList" class="finance-list"></div>
          </div>
          <div class="finance-card">
            <h3 class="finance-title"><span class="finance-icon amber" aria-hidden="true">⌂</span> د دوکان کرایه</h3>
            <form id="rentForm" class="finance-form">
              <input id="rentShopName" class="input" maxlength="100" value="زعفران بریانی" placeholder="د دوکان نوم" required />
              <input id="rentLandlord" class="input" maxlength="100" placeholder="د مالک نوم" required />
              <input id="rentPeriod" class="input" type="month" required />
              <input id="rentAmount" class="input" type="number" min="1" placeholder="د کرایې اندازه" required />
              <input id="rentNote" class="input" maxlength="200" placeholder="د کرایې وجه (که تش وي اتومات جوړېږي)" />
              <button class="button success" type="submit">کرایه رسید کړه</button>
            </form>
            <div id="rentList" class="finance-list"></div>
          </div>
        </section>

        <section class="capital-assets finance-card manager-view-panel hidden" data-manager-panel="capital" aria-labelledby="capitalAssetsTitle">
          <div class="capital-assets-head">
            <div>
              <span class="counter-expense-eyebrow">Separate Property Register</span>
              <h3 id="capitalAssetsTitle" class="finance-title"><span class="finance-icon rose" aria-hidden="true">◇</span> پانګه او د رستورانت وسایل</h3>
              <p>لګول شوې پانګه، TV، مېزونه او نور اجناس دلته ثبت کړئ. دا برخه د ګټې او مصرف له حساب څخه بشپړه جلا ده.</p>
            </div>
            <div class="capital-badge">په مالي حساب کې نه شمېرل کېږي</div>
          </div>
          <form id="capitalAssetForm" class="capital-asset-form">
            <select id="capitalAssetType" class="select" required><option value="asset">جنس / وسیله</option><option value="capital">نغدي پانګه</option></select>
            <input id="capitalAssetName" class="input" maxlength="100" placeholder="مثال: TV، مېزونه یا د مدیر پانګه" required />
            <input id="capitalAssetQuantity" class="input" type="number" min="1" value="1" placeholder="تعداد" required />
            <input id="capitalAssetAmount" class="input" type="number" min="0" placeholder="قیمت یا اندازه" required />
            <input id="capitalAssetDate" class="input" type="date" required />
            <input id="capitalAssetNote" class="input" maxlength="200" placeholder="یادښت (اختیاري)" />
            <button class="button success" type="submit">جلا ثبت یې کړه</button>
          </form>
          <div class="capital-summary"><span>ټوله ثبت شوې پانګه او وسایل</span><strong id="capitalAssetsTotal">0 AFN</strong></div>
          <div id="capitalAssetList" class="finance-list capital-list"></div>
        </section>

        <section class="inventory-manager finance-card manager-view-panel hidden" data-manager-panel="inventory" aria-labelledby="inventoryTitle">
          <div class="capital-assets-head">
            <div>
              <span class="counter-expense-eyebrow">Live Inventory</span>
              <h3 id="inventoryTitle" class="finance-title"><span class="finance-icon indigo" aria-hidden="true">▤</span> د مشروباتو ژوندی سټاک</h3>
              <p>یوازې واړه او غټ بوتلونه؛ د هر Checkout پر وخت تعداد او مالي ارزښت په اوتومات ډول کمېږي.</p>
            </div>
            <div class="inventory-total-badge"><b id="inventoryItemCount">0</b><span>ثبت شوي اجناس</span></div>
          </div>
          <div class="inventory-value-summary">
            <div><span>ټول پاتې بوتلونه</span><strong id="inventoryBottleTotal">0</strong></div>
            <div><span>د پېر ټول ارزښت</span><strong id="inventoryCostValue">0 AFN</strong></div>
            <div><span>د پلور ټول ارزښت</span><strong id="inventoryRetailValue">0 AFN</strong></div>
            <div><span>اټکلي ګټه</span><strong id="inventoryPotentialProfit">0 AFN</strong></div>
          </div>
          <form id="inventoryReceiveForm" class="inventory-form">
            <label class="field"><span>واړه یا غټ مشروب</span><select id="inventoryMenuItem" class="select" required></select></label>
            <label class="field"><span>داخل شوی تعداد</span><input id="inventoryQuantity" class="input" type="number" min="1" placeholder="مثال: 20" required /></label>
            <label class="field"><span>واحد</span><select id="inventoryUnit" class="select" required><option>بوتل</option><option>دانه</option><option>کارتن</option><option>درجن</option></select></label>
            <label class="field"><span>د یو واحد پېر قیمت</span><input id="inventoryPurchasePrice" class="input" type="number" min="0" placeholder="مثال: 50" required /></label>
            <label class="field"><span>ټول راوړلو قیمت</span><input id="inventoryPurchaseTotal" class="input" type="text" value="0 AFN" readonly /></label>
            <label class="field"><span>د یو واحد خرڅ قیمت</span><input id="inventorySalePrice" class="input" type="number" min="0" placeholder="مثال: 80" required /></label>
            <label class="field"><span>د خبرتیا حد</span><input id="inventoryReorderLevel" class="input" type="number" min="0" value="5" required /></label>
            <label class="field"><span>یادښت</span><input id="inventoryNote" class="input" maxlength="200" placeholder="اختیاري" /></label>
            <button class="button success" type="submit">سټاک ته داخل کړه</button>
          </form>
          <div id="inventoryStockGrid" class="inventory-stock-grid"></div>
          <details class="inventory-movements">
            <summary>د داخل او وتلو وروستۍ تاریخچه</summary>
            <div id="inventoryMovementList" class="finance-list"></div>
          </details>
        </section>

        <section class="counter-expense-manager manager-view-panel hidden" data-manager-panel="expenses" aria-labelledby="expenseManagerTitle">
          <div class="counter-expense-head">
            <div>
              <span class="counter-expense-eyebrow">Daily Expenses</span>
              <h3 id="expenseManagerTitle" class="finance-title"><span class="finance-icon red" aria-hidden="true">−</span> د ورځني مصرف مدیریت</h3>
              <p>دلته یوازې عادي ورځني مصارف ثبتېږي؛ معاش او کرایه په خپل جلا حساب کې دي.</p>
            </div>
            <div class="counter-expense-total">
              <span>د نن عادي مصرف</span>
              <strong id="todayExpenseTotal">0 AFN</strong>
              <button id="deleteAllExpensesButton" class="button danger" type="button">ورځنی لست پاک کړه</button>
            </div>
          </div>
          <form id="expenseForm" class="counter-expense-form">
            <div class="field">
              <label for="expenseName">د مصرف نوم</label>
              <input id="expenseName" class="input" type="text" maxlength="100" placeholder="مثال: مستې، سبزي یا ترانسپورټ" required />
            </div>
            <div class="field">
              <label for="expenseCategory">د مصرف کټګوري</label>
              <select id="expenseCategory" class="select" required>
                <option value="ingredients">خوراکي مواد / اجناس</option>
                <option value="transport">ترانسپورټ</option>
                <option value="utilities">برېښنا، اوبه او خدمات</option>
                <option value="maintenance">ترمیم او ساتنه</option>
                <option value="general">نور مصرف</option>
              </select>
            </div>
            <div class="field">
              <label for="expenseAmount">اندازه په افغانۍ</label>
              <input id="expenseAmount" class="input" type="number" min="1" max="10000000" step="1" inputmode="numeric" placeholder="500" required />
            </div>
            <div class="field">
              <label for="expenseNote">د مصرف وجه / وضاحت (اختیاري)</label>
              <input id="expenseNote" class="input" type="text" maxlength="200" placeholder="که تش وي، سیستم یې پخپله جوړوي" />
            </div>
            <button id="saveExpenseButton" class="button success" type="submit">نوی مصرف ثبت کړه</button>
          </form>
          <div id="expenseList" class="counter-expense-list"></div>
        </section>
        </div>

        <div class="manager-view-panel menu-catalog-panel" data-manager-panel="menu">
        <form id="counterMenuForm" class="counter-menu-form">
          <div class="field">
            <label for="menuGroupId">کټګوري / برخه</label>
            <select id="menuGroupId" class="select" required></select>
            <small id="menuCategoryHint" class="field-hint"></small>
          </div>
          <div class="field">
            <label for="newMenuName">د خوراک نوم</label>
            <input id="newMenuName" class="input" type="text" maxlength="100" placeholder="مثال: سپیشل چکن برګر" required />
          </div>
          <div class="field">
            <label for="newMenuPrice">قیمت په افغانۍ</label>
            <input id="newMenuPrice" class="input" type="number" min="1" max="1000000" step="1" inputmode="numeric" placeholder="150" required />
          </div>
          <button id="saveMenuItemButton" class="button success" type="submit">ذخیره کول</button>
        </form>
        <div class="counter-menu-search" role="search">
          <label for="menuSearch">په مینیو کې ژر لټون</label>
          <div class="counter-menu-search-bar">
            <span class="counter-menu-search-icon" aria-hidden="true">⌕</span>
            <input id="menuSearch" class="input" type="search" autocomplete="off" placeholder="د خوراک نوم، کټګوري یا قیمت ولیکئ…" />
            <button id="clearMenuSearch" class="button ghost hidden" type="button">پاکول</button>
          </div>
          <small id="menuSearchResult" class="field-hint">ټول توکي ښودل کېږي</small>
        </div>
        <div id="counterCustomMenuItems" class="counter-custom-menu-list"></div>
        </div>
      </section>

      <div class="dashboard-grid counter-live-grid">
        <section class="panel span-7 counter-live-panel counter-tables-panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Open Tables</h2>
              <p class="panel-kicker">فعال میزونه</p>
            </div>
            <span id="openTicketCount" class="chip">0 tickets</span>
          </div>
          <div id="activeTables" class="orders-list"></div>
        </section>

        <div class="span-5 side-stack">
          <aside class="panel counter-live-panel counter-history-panel">
            <div class="panel-header">
              <div>
                <h2 class="panel-title">Sales History</h2>
                <p class="panel-kicker">د خرڅلاو تاریخچه</p>
              </div>
              <div class="top-actions">
