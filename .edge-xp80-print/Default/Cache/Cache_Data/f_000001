      window.KandaharAuth.showLoginIntro(role, unlockPage);
    }

    function unlockPage() {
      $('loginScreen').classList.add('hidden');
      $('app').classList.remove('hidden');
      startApp();
    }

    async function enableOrderAlertSound() {
      if (!state.orderAlertAudio) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return null;
        state.orderAlertAudio = new AudioContextClass();
      }
      if (state.orderAlertAudio.state === 'suspended') {
        await state.orderAlertAudio.resume().catch(() => {});
      }
      return state.orderAlertAudio;
    }

    async function unlockOrderAlertOnInteraction() {
      const audio = await enableOrderAlertSound();
      if (!audio || audio.state !== 'running') return;
      document.removeEventListener('pointerdown', unlockOrderAlertOnInteraction);
      document.removeEventListener('click', unlockOrderAlertOnInteraction);
      document.removeEventListener('keydown', unlockOrderAlertOnInteraction);
    }

    async function playNewOrderAlert() {
      const audio = await enableOrderAlertSound();
      if (!audio || audio.state !== 'running') return false;

      const startAt = audio.currentTime + 0.03;
      const alertPattern = [
        [0, 880],
        [0.24, 1046],
        [0.48, 880],
        [0.9, 1046],
        [1.14, 1318]
      ];
      alertPattern.forEach(([delay, frequency]) => {
        const oscillator = audio.createOscillator();
        const gain = audio.createGain();
        oscillator.type = 'square';
        oscillator.frequency.setValueAtTime(frequency, startAt + delay);
        gain.gain.setValueAtTime(0.0001, startAt + delay);
        gain.gain.exponentialRampToValueAtTime(0.32, startAt + delay + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, startAt + delay + 0.18);
        oscillator.connect(gain);
        gain.connect(audio.destination);
        oscillator.start(startAt + delay);
        oscillator.stop(startAt + delay + 0.2);
      });
      await new Promise((resolve) => setTimeout(resolve, 1450));
      return true;
    }

    function checkExistingLogin() {
      const roleKey = window.KandaharAuth.currentRole();
      if (!roleKey) return;
      if (roleKey !== PAGE_ROLE) {
        window.KandaharAuth.redirectToRole(roleKey);
        return;
      }
      unlockPage();
    }

    function startApp() {
      if (state.socket) return;
      render();

      state.socket = io({ transports: ['websocket', 'polling'] });
      state.socket.on('connect', () => {
        $('connectionStatus').textContent = 'Live';
        state.socket.emit('request_snapshot');
      });
      state.socket.on('disconnect', () => {
        $('connectionStatus').textContent = 'Offline';
      });
      state.socket.on('snapshot', (snapshot) => {
        state.snapshot = snapshot || state.snapshot;
        render();
      });
      state.socket.on('active_orders', (orders) => {
        replaceActiveOrders(orders);
      });
      state.socket.on('display_order_in_counter', (order) => {
        upsertActiveOrder(order);
      });
      const handleIncomingOrder = (order) => {
        if (!order?.id || state.alertedOrderIds.has(order.id)) return;
        state.alertedOrderIds.add(order.id);
        playNewOrderAlert();
        upsertActiveOrder(order);
        const orderLabel = order?.orderNumber || order?.tableNumber || '';
        showToast(
          `نوی آرډر راغی${orderLabel ? ` · ${orderLabel}` : ''} — د چاپ لپاره د آرډر پرینټ تڼۍ ووهئ`,
          'success'
        );
      };
      state.socket.on('order_created', handleIncomingOrder);
      state.socket.on('new_order', handleIncomingOrder);
      state.socket.on('system_theme_updated', (theme) => {
        window.PizzaPointApplySystemTheme?.(theme);
      });
      state.socket.on('expenses_updated', (expenses) => {
        state.snapshot = { ...state.snapshot, expenses: Array.isArray(expenses) ? expenses : [] };
        renderStats();
        renderExpenses();
      });
      state.socket.on('monthly_account_updated', (monthlyAccount) => {
        state.snapshot = { ...state.snapshot, monthlyAccount };
        renderMonthlyAccount();
      });
      state.socket.on('financial_accounts_updated', (accounts) => {
        applyFinancialAccounts(accounts);
      });
      state.socket.on('employees_updated', (employees) => {
        state.finance = { ...state.finance, employees: Array.isArray(employees) ? employees : [] };
        renderFinance();
      });
      state.socket.on('payroll_updated', (payroll) => {
        state.finance = { ...state.finance, payroll: Array.isArray(payroll) ? payroll : [] };
        renderFinance();
      });
      state.socket.on('rents_updated', (rents) => {
        state.finance = { ...state.finance, rents: Array.isArray(rents) ? rents : [] };
        renderFinance();
      });
      state.socket.on('inventory_updated', (inventory) => {
        state.finance = { ...state.finance, inventory: Array.isArray(inventory) ? inventory : [] };
        renderFinance();
      });
      state.socket.on('inventory_movements_updated', (inventoryMovements) => {
        state.finance = { ...state.finance, inventoryMovements: Array.isArray(inventoryMovements) ? inventoryMovements : [] };
        renderFinance();
      });
      state.socket.on('order_updated_notification', (data) => {
        playNewOrderAlert();
        applyOrderUpdate(data);
        const tableLabel = data?.tableNumber || data?.table || '';
        showToast(`د Table ${tableLabel} آرډر تغیر شو — نوې پارچه پرینټ کړئ`, 'success');
      });
      state.socket.on('app_error', (error) => showToast(error.message || 'Server error', 'danger'));
    }

    function render() {
      renderStats();
      renderActiveTables();
      renderHistory();
      renderExpenses();
      renderMonthlyAccount();
    }

    function applyFinancialAccounts(accounts) {
      if (!accounts) return;
      state.snapshot = {
        ...state.snapshot,
        expenses: Array.isArray(accounts.expenses) ? accounts.expenses : state.snapshot.expenses,
        monthlyAccount: accounts.monthlyAccount || state.snapshot.monthlyAccount
      };
      const selectedYear = Number($('financeYear').value) || new Date().getFullYear();
      state.finance = {
        ...state.finance,
        ...(Array.isArray(accounts.employees) ? { employees: accounts.employees } : {}),
        ...(Array.isArray(accounts.payroll) ? { payroll: accounts.payroll } : {}),
        ...(Array.isArray(accounts.rents) ? { rents: accounts.rents } : {}),
        ...(Array.isArray(accounts.inventory) ? { inventory: accounts.inventory } : {}),
        ...(Array.isArray(accounts.inventoryMovements) ? { inventoryMovements: accounts.inventoryMovements } : {}),
        ...(Number(accounts.annualAccount?.year) === selectedYear ? { annualAccount: accounts.annualAccount } : {})
      };
      renderStats();
      renderExpenses();
      renderMonthlyAccount();
      renderFinance();
    }

    function renderMonthlyAccount() {
      const account = state.snapshot.monthlyAccount || { items: {}, expenses: [] };
      const expenses = Array.isArray(account.expenses) ? account.expenses : [];
      const salesTotal = Number(account.salesTotal) || 0;
      const expenseTotal = Number(account.expensesTotal) || 0;
      const inventoryCostTotal = Number(account.inventoryCostTotal) || 0;
      const items = Object.values(account.items || {}).sort((a, b) => (Number(b.quantity) || 0) - (Number(a.quantity) || 0));
      const unitTotal = Number(account.unitsTotal) || items.reduce((sum, item) => sum + (Number(item.quantity) || 0), 0);
      const weekDays = ['یکشنبه', 'دوشنبه', 'سه شنبه', 'چهارشنبه', 'پنجشنبه', 'جمعه', 'شنبه'];

      $('monthlySalesTotal').textContent = money(salesTotal);
      $('monthlyExpenseTotal').textContent = money(expenseTotal);
      $('monthlyInventoryCost').textContent = money(inventoryCostTotal);
      $('monthlyNetTotal').textContent = money(account.exactProfit ?? (salesTotal - expenseTotal - inventoryCostTotal));
      $('monthlyNetTotal').classList.toggle('is-negative', Number(account.exactProfit ?? (salesTotal - expenseTotal - inventoryCostTotal)) < 0);
      $('monthlyUnitsTotal').textContent = Math.round(unitTotal).toLocaleString();
      $('monthlyDayList').innerHTML = (account.days || []).map((day) => {
        const date = new Date(`${day.date}T12:00:00`);
        return `<div class="monthly-day-row"><span><b>${weekDays[date.getDay()]}</b><small>${escapeHtml(day.date)}</small></span><span>کار/خرڅ: <b>${money(day.sales)}</b></span><span>مصرف: <b>${money(day.expenses)}</b></span><span>د اجناسو پېر: <b>${money(day.inventoryCost)}</b></span><strong class="${Number(day.profit) < 0 ? 'is-negative' : ''}">خالصه ګټه: ${money(day.profit)}</strong></div>`;
      }).join('') || '<div class="empty-state compact">د دې میاشتې ورځنی حساب نشته.</div>';
      const startedAt = new Date(account.startedAt);
