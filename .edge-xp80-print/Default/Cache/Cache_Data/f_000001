    function showToast(message, type) {
      const toast = $('toast');
      toast.textContent = message;
      toast.className = `notice ${type === 'danger' ? 'danger' : 'success'}`;
      toast.classList.remove('hidden');
      clearTimeout(window.__toastTimeout);
      window.__toastTimeout = setTimeout(() => toast.classList.add('hidden'), 4200);
    }

    function formatDate(value) {
      if (!value) return '';
      return new Date(value).toLocaleString([], {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    function formatOrderDateTime(value) {
      if (!value) return 'وخت نشته';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'وخت نشته';
      return date.toLocaleString('en-GB', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true
      }).replace(/\b(am|pm)\b/i, (marker) => marker.toUpperCase());
    }

    function formatReceiptDate(value) {
      const date = value ? new Date(value) : new Date();
      return date.toLocaleDateString('en-GB', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric'
      });
    }

    function receiptMoney(value) {
      return Math.round(Number(value) || 0).toLocaleString();
    }

    function formatReceiptTime(value) {
      const date = value ? new Date(value) : new Date();
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function loadPrintLog() {
      try {
        const items = JSON.parse(localStorage.getItem(PRINT_LOG_KEY) || '[]');
        return Array.isArray(items) ? items : [];
      } catch (error) {
        return [];
      }
    }

    function getOrderPrintInfo(orderId) {
      return state.printLog.find((item) => item.orderId === orderId) || null;
    }

    function isOrderUpdatedAfterPrint(order) {
      const printInfo = getOrderPrintInfo(order?.id);
      if (!printInfo || !order?.updatedAt) return false;
      return Date.parse(order.updatedAt) > Date.parse(printInfo.printedAt || 0);
    }

    function hasPendingOrderPrintSlip(order) {
      if (!order?.id) return false;
      if (isOrderUpdatedAfterPrint(order)) return true;
      return Boolean(order.isAdditionalOrder && !getOrderPrintInfo(order.id));
    }

    function recordCounterPrint(order) {
      const current = Number(localStorage.getItem(PRINT_COUNTER_KEY)) || 0;
      const existing = getOrderPrintInfo(order.id);
      const printInfo = {
        orderId: order.id,
        printNumber: current + 1,
        printedAt: new Date().toISOString(),
        printCount: existing ? (Number(existing.printCount) || 1) + 1 : 1,
        previousPrintNumbers: existing
          ? [...(existing.previousPrintNumbers || []), existing.printNumber].slice(-10)
          : []
      };
      localStorage.setItem(PRINT_COUNTER_KEY, String(printInfo.printNumber));
      state.printLog = [printInfo, ...state.printLog.filter((item) => item.orderId !== order.id)].slice(0, 200);
      localStorage.setItem(PRINT_LOG_KEY, JSON.stringify(state.printLog));
      return printInfo;
    }

    function buildOpenOrderReceiptHtml(order, printInfo) {
      const createdAt = order.createdAt || new Date().toISOString();
      const items = order.items || [];
      const isDelivery = order.orderType === 'delivery';
      const grandTotal = Math.max(0, Number(order.total) || items.reduce((sum, item) => (
        sum + (Number(item.lineTotal) || Number(item.price) * Number(item.qty) || 0)
      ), 0));
      const tableLabel = formatReceiptTableLabel(order);
      const orderNote = String(order.note || '').trim();
      const infoRows = isDelivery
        ? [
            ['Date', formatReceiptDate(createdAt)],
            ['Phone Number', order.customerPhone || '-'],
            ['Customer Name', order.customerName || '-'],
            ['Address', order.deliveryAddress || '-']
          ]
        : [
            ['Date', formatReceiptDate(createdAt)],
            [order.orderType === 'counter' || order.orderType === 'fake' ? 'Order' : 'Table', tableLabel]
          ];
      const itemRows = items.length ? items.map((item, index) => {
        const qty = Number(item.qty) || 0;
        const lineTotal = Number(item.lineTotal) || Number(item.price) * qty;
        const unitPrice = Number(item.price) || (qty ? lineTotal / qty : 0);
        return `<tr><td>${index + 1}</td><td class="receipt-simple-name">${escapeHtml(displayItemName(item.name))}</td><td>${qty}</td><td class="receipt-simple-price">${receiptMoney(unitPrice)}</td><td class="receipt-simple-price">${receiptMoney(lineTotal)}</td></tr>`;
      }).join('') : '<tr><td class="receipt-simple-name" colspan="5">No items</td></tr>';

      return `
          <div class="receipt-paper receipt-simple kitchen-receipt">
          <img class="receipt-simple-logo" src="/images/zaffran-receipt-logo.png" alt="زعفران بریانی" />
          <div class="receipt-print-mark">پرینټ نمبر #${escapeHtml(printInfo.printNumber)}</div>
          <div class="receipt-print-time">Printed at ${escapeHtml(formatReceiptTime(printInfo.printedAt))}</div>
          <div class="receipt-simple-info">
            ${infoRows.map(([label, value]) => `<div class="receipt-simple-info-row"><span>${escapeHtml(label)}:</span><strong>${escapeHtml(value)}</strong></div>`).join('')}
          </div>
          ${orderNote ? `
            <div class="receipt-order-note">
              <span>${escapeHtml(orderNote)}</span>
            </div>
          ` : ''}
          <div class="receipt-simple-hr"></div>
          <table class="receipt-simple-table">
            <thead><tr><th>#</th><th>توکی</th><th>تعداد</th><th>فی نرخ</th><th>مجموعه</th></tr></thead>
            <tbody>${itemRows}</tbody>
          </table>
          <div class="receipt-simple-hr"></div>
          <div class="receipt-simple-total-line"><span>مجموعه:</span><span>${receiptMoney(grandTotal)}</span></div>
          <div class="receipt-simple-hr-double"></div>
          <p class="receipt-simple-thanks">مهرباني بیل کونټر ته تسلیم کړی</p>
          ${isDelivery ? '<p class="receipt-simple-thanks">مننه چي موږ مو انتخاب کړو</p>' : ''}
        </div>`;
    }

    function printOpenOrderObject(order) {
      if (!order?.id || state.printInProgress) return;
      state.printInProgress = true;
      const printInfo = recordCounterPrint(order);
      $('receiptPrint').classList.add('kitchen-receipt-print');
      $('receiptPrint').innerHTML = buildOpenOrderReceiptHtml(order, printInfo);
      document.body.classList.add('print-receipt-mode');
      renderActiveTables();
      printReceiptWhenReady();
    }

    function printOpenOrder(orderId) {
      const order = (state.snapshot.activeOrders || []).find((item) => item.id === orderId);
      if (!order) return showToast('Order not found', 'danger');
      printOpenOrderObject(order);
    }

    function collectReceiptText(...values) {
      const parts = [];
      const push = (value) => {
        if (Array.isArray(value)) {
          value.forEach(push);
          return;
        }
        const text = String(value ?? '').trim();
        if (text && !parts.includes(text)) {
          parts.push(text);
        }
      };

      values.forEach(push);
      return parts.join(' · ');
    }

    function formatInvoiceNumber(bill) {
      const raw = String(bill.id || bill.orderIds?.[0] || Date.now());
      const compact = raw.replace(/[^a-zA-Z0-9]/g, '').slice(-8).toUpperCase();
      return compact ? `#${compact}` : '#00000000';
    }

    function formatReceiptTableLabel(bill) {
      if (bill.orderType === 'delivery') return 'Delivery';
      if (bill.orderType === 'fake') return 'فیک اډر';
      if (bill.orderType === 'counter') return 'Counter Order';
      const tableNo = bill.tableNumber || bill.table;
      return tableNo != null && tableNo !== '' ? String(tableNo) : '-';
    }

    function buildReceiptHtml(bill) {
      const paidAt = bill.paidAt || bill.checkoutTimestamp || new Date().toISOString();
      const items = bill.items || [];
      const customerNote = collectReceiptText(bill.note, bill.customerNote, bill.specialInstructions, bill.notes);
      const grandTotal = Math.max(0, Number(bill.total) || items.reduce((sum, item) => (
        sum + (Number(item.lineTotal) || Number(item.price) * Number(item.qty) || 0)
      ), 0));
      const tableLabel = formatReceiptTableLabel(bill);
      const customerRows = [
        ['Date', formatReceiptDate(paidAt)],
        [bill.orderType === 'delivery' || bill.orderType === 'counter' || bill.orderType === 'fake' ? 'Order' : 'Table', tableLabel],
        bill.customerName ? ['Customer', bill.customerName] : null,
        bill.customerPhone ? ['Phone', bill.customerPhone] : null,
        bill.deliveryAddress ? ['Address', bill.deliveryAddress] : null,
        customerNote ? ['Note', customerNote] : null
      ].filter(Boolean);

      const itemRows = items.length
        ? items.map((item, index) => {
            const qty = Number(item.qty) || 0;
            const lineTotal = Number(item.lineTotal) || Number(item.price) * qty;
            const unitPrice = Number(item.price) || (qty ? lineTotal / qty : 0);
            return `
              <tr>
                <td>${index + 1}</td>
                <td class="receipt-simple-name">${escapeHtml(displayItemName(item.name))}</td>
                <td>${qty}</td>
                <td class="receipt-simple-price">${receiptMoney(unitPrice)}</td>
                <td class="receipt-simple-price">${receiptMoney(lineTotal)}</td>
              </tr>
            `;
          }).join('')
        : '<tr><td class="receipt-simple-name" colspan="5">No items</td></tr>';

      return `
        <div class="receipt-paper receipt-simple">
          <img class="receipt-simple-logo" src="/images/zaffran-receipt-logo.png" alt="زعفران بریانی" />

          <div class="receipt-simple-info">
            ${customerRows.map(([label, value]) => `
              <div class="receipt-simple-info-row">
                <span>${escapeHtml(label)}:</span>
                <strong>${escapeHtml(value)}</strong>
              </div>
            `).join('')}
          </div>

          <div class="receipt-simple-hr"></div>

          <table class="receipt-simple-table">
            <thead><tr><th>#</th><th>توکی</th><th>تعداد</th><th>فی نرخ</th><th>مجموعه</th></tr></thead>
            <tbody>${itemRows}</tbody>
          </table>

          <div class="receipt-simple-hr"></div>

          <div class="receipt-simple-total-line">
            <span>مجموعه:</span>
            <span>${receiptMoney(grandTotal)}</span>
          </div>

          <div class="receipt-simple-hr-double"></div>

          <p class="receipt-simple-thanks">مننه چي موږ مو انتخاب کړو</p>

          <div class="receipt-simple-hr"></div>

          <p class="receipt-simple-phone">${escapeHtml(RECEIPT_CONFIG.phone)}</p>
        </div>
      `;
    }

    window.addEventListener('afterprint', () => {
      document.body.classList.remove('print-receipt-mode');
      $('receiptPrint').classList.remove('kitchen-receipt-print');
      document.getElementById('receiptDynamicPageSize')?.remove();
      state.printInProgress = false;
    });

    $('loginButton').addEventListener('click', checkPassword);
    document.addEventListener('pointerdown', unlockOrderAlertOnInteraction);
    document.addEventListener('click', unlockOrderAlertOnInteraction);
    document.addEventListener('keydown', unlockOrderAlertOnInteraction);
    $('counterPassword').addEventListener('keydown', (event) => {
      if (event.key === 'Enter') checkPassword();
    });
    $('activeTables').addEventListener('click', (event) => {
      const printButton = event.target.closest('[data-print-order]');
      if (printButton) {
        printOpenOrder(printButton.dataset.printOrder);
        return;
      }

      const button = event.target.closest('[data-checkout]');
      if (!button) return;
      checkoutTable(button.dataset.checkout);
    });
    $('historyList').addEventListener('click', (event) => {
      const printButton = event.target.closest('[data-print-bill]');
      if (!printButton) return;
      printHistoryBill(printButton.dataset.printBill);
    });
    $('clearHistoryButton').addEventListener('click', clearHistory);
    $('printButton').addEventListener('click', printLastCheckoutReceipt);
    $('toggleMenuManagerButton').addEventListener('click', () => {
      setMenuManagerVisible($('counterMenuManager').classList.contains('hidden'));
    });
    $('hideMenuManagerButton').addEventListener('click', () => setMenuManagerVisible(false));
    document.querySelector('.manager-command-nav').addEventListener('click', (event) => {
      const button = event.target.closest('[data-manager-view]');
      if (button) showManagerView(button.dataset.managerView);
    });
    $('menuGroupId').addEventListener('change', updateMenuCategoryHint);
    $('counterMenuForm').addEventListener('submit', saveNewMenuItem);
    $('expenseForm').addEventListener('submit', saveExpense);
    $('refreshFinanceButton').addEventListener('click', loadFinance);
    $('deleteMonthlyAccountButton').addEventListener('click', deleteMonthlyFinancialAccount);
    $('deleteAnnualAccountButton').addEventListener('click', deleteAnnualFinancialAccount);
    const currentPeriod = localMonthKey();
    state.calendarPeriod = currentPeriod;
    $('financeMonth').value = currentPeriod;
    $('payrollPeriod').value = currentPeriod;
    $('rentPeriod').value = currentPeriod;
    $('capitalAssetDate').value = localDateKey();
    window.setInterval(() => checkCalendarRollover().catch(() => {}), 15000);
    $('financeYear').addEventListener('change', loadFinance);
    $('financeMonth').addEventListener('change', loadFinance);
    $('employeeForm').addEventListener('submit', saveEmployee);
    $('payrollForm').addEventListener('submit', savePayroll);
    $('rentForm').addEventListener('submit', saveRent);
    $('capitalAssetForm').addEventListener('submit', (event) => submitFinanceForm(event, '/api/capital-assets', () => ({ type: $('capitalAssetType').value, name: $('capitalAssetName').value, quantity: Number($('capitalAssetQuantity').value), amount: Number($('capitalAssetAmount').value), acquiredAt: $('capitalAssetDate').value, note: $('capitalAssetNote').value })));
    function updateInventoryPurchaseTotal() {
      $('inventoryPurchaseTotal').value = money((Number($('inventoryQuantity').value) || 0) * (Number($('inventoryPurchasePrice').value) || 0));
    }
    $('inventoryReceiveForm').addEventListener('submit', (event) => submitFinanceForm(event, '/api/inventory/receive', () => {
      const option = $('inventoryMenuItem').selectedOptions[0];
      return { itemId: $('inventoryMenuItem').value, itemName: option?.dataset.name || option?.textContent || '', groupId: option?.dataset.groupId || '', quantity: Number($('inventoryQuantity').value), unit: $('inventoryUnit').value, purchasePrice: Number($('inventoryPurchasePrice').value), salePrice: Number($('inventorySalePrice').value), reorderLevel: Number($('inventoryReorderLevel').value), note: $('inventoryNote').value };
    }));
    ['inventoryQuantity', 'inventoryPurchasePrice'].forEach((id) => $(id).addEventListener('input', updateInventoryPurchaseTotal));
    $('inventoryMenuItem').addEventListener('change', () => {
      const price = $('inventoryMenuItem').selectedOptions[0]?.dataset.price;
      if (price) $('inventorySalePrice').value = price;
    });
    $('inventoryStockGrid').addEventListener('click', async (event) => {
      const button = event.target.closest('[data-delete-inventory]');
      if (!button) return;
      const name = button.dataset.inventoryName || 'دا مشروب';
      if (!confirm(`${name} له سټاک څخه بشپړ حذف شي؟ تعداد، غلط قیمت او د داخل/وتلو تاریخچه به پاکه شي، بیا یې له سره ثبتولی شئ.`)) return;
      button.disabled = true;
      try {
        const data = await menuManagerRequest(`/api/inventory/${encodeURIComponent(button.dataset.deleteInventory)}`, { method: 'DELETE' });
        if (data.financialAccounts) applyFinancialAccounts(data.financialAccounts);
        state.finance = { ...state.finance, inventory: data.inventory || [], inventoryMovements: data.inventoryMovements || [] };
        renderFinance();
        showMenuManagerMessage(`${name} له سټاک او تاریخچې حذف شو؛ اوس یې له سره په سم قیمت او تعداد ثبت کړئ.`);
        showToast('مشروب له سټاک څخه حذف شو.', 'success');
      } catch (error) {
        showMenuManagerMessage(error.message, 'danger');
        button.disabled = false;
      }
    });
    window.addEventListener('asad-menu-prices-updated', () => {
      fillInventoryMenuItems();
      renderFinance();
    });
    function updatePayrollFields() {
      const option = $('payrollEmployee').selectedOptions[0];
      if (option?.dataset.salary) $('payrollAmount').value = option.dataset.salary;
      const employeeName = option?.textContent?.split('—')[0]?.trim();
      if ($('payrollEmployee').value && employeeName) $('payrollNote').value = `د ${employeeName} د ${$('payrollPeriod').value} میاشتې معاش`;
    }
    $('payrollEmployee').addEventListener('change', updatePayrollFields);
    $('payrollPeriod').addEventListener('change', updatePayrollFields);
    $('employeeList').addEventListener('click', async (event) => {
      const button = event.target.closest('[data-delete-employee]');
      if (!button || !confirm('دا کارمند حذف شي؟ پخواني معاش رسیدونه به پاتې وي.')) return;
      try {
        const data = await menuManagerRequest(`/api/employees/${encodeURIComponent(button.dataset.deleteEmployee)}`, { method: 'DELETE' });
        state.finance = { ...state.finance, employees: data.employees || [] };
        renderFinance();
        showToast('کارمند حذف شو؛ پخوانی معاش تاریخ په حساب کې خوندي دی.', 'success');
      }
      catch (error) { showMenuManagerMessage(error.message, 'danger'); }
    });
    $('capitalAssetList').addEventListener('click', async (event) => {
      const button = event.target.closest('[data-delete-capital]');
      if (!button || !confirm('دا دایمي ثبت شوی جنس یا پانګه د مدیر په لاس له MongoDB څخه حذف شي؟')) return;
      try { await menuManagerRequest(`/api/capital-assets/${encodeURIComponent(button.dataset.deleteCapital)}`, { method: 'DELETE' }); await loadFinance(); }
      catch (error) { showMenuManagerMessage(error.message, 'danger'); }
    });
    $('payrollList').addEventListener('click', async (event) => {
      const button = event.target.closest('[data-delete-payroll]');
      if (!button || !confirm('دا د معاش رسید یوازې له دې لست څخه حذف شي؟ معاش به په ورځني، میاشتني او کلني حساب کې خوندي پاتې وي.')) return;
      button.disabled = true;
      try {
        const data = await menuManagerRequest(`/api/payroll/${encodeURIComponent(button.dataset.deletePayroll)}`, { method: 'DELETE' });
        state.finance = { ...state.finance, payroll: data.payroll || [] };
        applyFinancialAccounts(data.financialAccounts);
        renderFinance();
        showToast('رسید له لست څخه حذف شو؛ معاش په ټولو مالي حسابونو کې خوندي دی.', 'success');
      } catch (error) { showToast(error.message, 'danger'); button.disabled = false; }
    });
    $('rentList').addEventListener('click', async (event) => {
      const button = event.target.closest('[data-delete-rent]');
      if (!button || !confirm('دا د کرایې رسید یوازې له دې لست څخه حذف شي؟ کرایه به په ورځني، میاشتني او کلني حساب کې خوندي پاتې وي.')) return;
      button.disabled = true;
      try {
        const data = await menuManagerRequest(`/api/rents/${encodeURIComponent(button.dataset.deleteRent)}`, { method: 'DELETE' });
        state.finance = { ...state.finance, rents: data.rents || [] };
        applyFinancialAccounts(data.financialAccounts);
        renderFinance();
        showToast('رسید له لست څخه حذف شو؛ کرایه په ټولو مالي حسابونو کې خوندي ده.', 'success');
      } catch (error) { showToast(error.message, 'danger'); button.disabled = false; }
    });
    $('expenseList').addEventListener('click', (event) => {
      const button = event.target.closest('[data-delete-expense]');
      if (button) deleteExpense(button.dataset.deleteExpense);
    });
    $('deleteAllExpensesButton').addEventListener('click', deleteAllManualExpenses);
    $('counterCustomMenuItems').addEventListener('click', (event) => {
      const saveButton = event.target.closest('[data-save-menu-price]');
      if (saveButton) {
        saveMenuPrice(saveButton.dataset.saveMenuPrice, saveButton);
        return;
      }
      const button = event.target.closest('[data-delete-menu-item]');
      if (button) deleteCounterMenuItem(button.dataset.deleteMenuItem);
    });
    $('menuSearch').addEventListener('input', renderAllMenuItems);
    $('clearMenuSearch').addEventListener('click', () => {
      $('menuSearch').value = '';
      renderAllMenuItems();
      $('menuSearch').focus();
    });
    $('logoutButton').addEventListener('click', window.KandaharAuth.logout);
    fillMenuCategories();
    loadCounterCustomMenu();
    renderExpenses();
    showManagerView(localStorage.getItem(MANAGER_VIEW_KEY) || 'menu').catch(() => {});
    checkExistingLogin();
  </script>
</body>
</html>
