    function refreshSnapshotStats() {
      const orders = state.snapshot.activeOrders || [];
      const activeTables = new Set(orders.map((order) => Number(order.tableNumber)).filter(Boolean));
      const activeTotal = orders.reduce((sum, order) => sum + (Number(order.total) || 0), 0);
      state.snapshot.stats = {
        ...(state.snapshot.stats || {}),
        activeOrderCount: orders.length,
        activeTableCount: activeTables.size,
        readyOrderCount: orders.filter((order) => order.status === 'ready').length,
        activeTotal
      };
    }

    function replaceActiveOrders(orders) {
      if (!Array.isArray(orders)) return;
      state.snapshot = {
        ...state.snapshot,
        activeOrders: orders
      };
      refreshSnapshotStats();
      render();
    }

    function upsertActiveOrder(order) {
      if (!order || !order.id) return;
      const orders = state.snapshot.activeOrders || [];
      const index = orders.findIndex((item) => item.id === order.id);
      const nextOrders = index === -1
        ? [order, ...orders]
        : orders.map((item) => (item.id === order.id ? { ...item, ...order } : item));
      state.snapshot = {
        ...state.snapshot,
        activeOrders: nextOrders
      };
      refreshSnapshotStats();
      render();
    }

    function applyOrderUpdate(data) {
      if (!data || !data.orderId) return;
      const orders = state.snapshot.activeOrders || [];
      if (!orders.some((order) => order.id === data.orderId)) return;

      state.snapshot = {
        ...state.snapshot,
        activeOrders: orders.map((order) => (
          order.id === data.orderId
            ? {
                ...order,
                items: Array.isArray(data.items) ? data.items : order.items,
                total: Number.isFinite(Number(data.total)) ? Number(data.total) : order.total,
                status: 'updated',
                readyAt: null,
                updatedAt: data.updatedAt || new Date().toISOString(),
                lastUpdatedBy: data.lastUpdatedBy || data.waiterName || order.lastUpdatedBy
              }
            : order
        ))
      };
      refreshSnapshotStats();
      render();
    }

    function renderStats() {
      const stats = state.snapshot.stats || {};
      const todayBills = (state.snapshot.orderHistory || []).filter((bill) => isToday(bill.paidAt || bill.checkoutTimestamp));
      const grossToday = todayBills.reduce((sum, bill) => sum + (Number(bill.total) || 0), 0);
      const expensesToday = (state.snapshot.expenses || []).filter((expense) => !expense.sourceType && !expense.hiddenFromDaily && isToday(expense.createdAt));
      const expenseTotal = expensesToday.reduce((sum, expense) => sum + (Number(expense.amount) || 0), 0);
      const netToday = grossToday - expenseTotal;
      $('statTables').textContent = stats.activeTableCount || 0;
      $('statOpenTotal').textContent = money(stats.activeTotal || 0);
      $('statRevenue').textContent = money(netToday);
      $('statRevenue').classList.toggle('is-negative', netToday < 0);
      $('statRevenueDetails').textContent = `عاید ${money(grossToday)} · مصرف ${money(expenseTotal)}`;
      $('openTicketCount').textContent = `${stats.activeOrderCount || 0} tickets`;
    }

    function isToday(value) {
      const date = new Date(value);
      const today = new Date();
      return !Number.isNaN(date.getTime())
        && date.getFullYear() === today.getFullYear()
        && date.getMonth() === today.getMonth()
        && date.getDate() === today.getDate();
    }

    function renderExpenses() {
      const expenses = (state.snapshot.expenses || []).filter((expense) => !expense.sourceType && !expense.hiddenFromDaily);
      const todayExpenses = expenses.filter((expense) => isToday(expense.createdAt));
      const total = todayExpenses.reduce((sum, expense) => sum + (Number(expense.amount) || 0), 0);
      $('todayExpenseTotal').textContent = money(total);
      $('expenseList').innerHTML = todayExpenses.length ? todayExpenses.map((expense) => `
